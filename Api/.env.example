NODE_ENV=development
PORT=<WHICHEVER PORT YOU WANT TO USE>
DATABASE_URL=<YOUR DATABASE URL>
JWT_SECRET=<AT LEAST 32 RANDOM CHARACTERS>
JWT_ISSUER=odo-api
JWT_AUDIENCE=odo-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Local development defaults target Mailpit from an API running on the host.
# In production, replace these values with the Brevo SMTP credentials.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=Odo <noreply@odo.local>
# MAIL_USER=
# MAIL_PASSWORD=
EMAIL_VERIFICATION_URL=http://localhost:5173/confirm-email
EMAIL_VERIFICATION_TTL_HOURS=24
